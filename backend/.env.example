# Copy this file to `.env` (in the backend/ directory) and fill in real values.
# `.env` is gitignored — never commit real secrets.
#
# All settings use the APP_ prefix (see app/config.py).

# Anthropic API key for the AI assistant feature. Get one at https://console.anthropic.com
APP_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (defaults shown):
# APP_ASSISTANT_MODEL=claude-opus-5
# APP_DATABASE_URL=postgresql+asyncpg://fantasy:fantasy_dev@localhost:5432/fantasy_draft
