# Copy this file to `.env` (in the backend/ directory) and fill in real values.
# `.env` is gitignored, and .dockerignore excludes it from the image — never
# commit real secrets, and never bake them into a build.
#
# All settings use the APP_ prefix (see app/config.py).

# Anthropic API key for the AI assistant feature. Get one at https://console.anthropic.com
APP_ANTHROPIC_API_KEY=sk-ant-your-key-here

# The AI assistant is HELD in the deployed app: leave this unset (or `false`)
# in production. Every question costs credits and the endpoint has no per-user
# quota yet, so an open deploy is an open tab. The frontend reads
# /api/assistant/status and shows a "coming soon" page when it's off.
# Defaults to true, so local development with a key set just works.
# APP_ASSISTANT_ENABLED=false

# Deployment only. Set to `production` on any deployed instance; the app then
# REFUSES TO START while APP_SECRET_KEY or APP_DATABASE_URL are still at their
# public development defaults. Leave unset for local development.
# APP_ENVIRONMENT=production
# APP_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(64))">

# Only needed if the frontend is served from a DIFFERENT origin than the API.
# The Docker image serves the built frontend itself, so in the normal deploy
# everything is same-origin and this stays unset.
#
# Note the format: pydantic-settings parses a list from env as JSON, so it must
# be a JSON array with double quotes, not a bare comma-separated string.
# APP_CORS_ORIGINS=["https://fantasydraft.example.com"]

# Optional overrides (defaults shown):
# APP_ASSISTANT_MODEL=claude-opus-5
# APP_DATABASE_URL=postgresql+asyncpg://fantasy:fantasy_dev@localhost:5432/fantasy_draft
# APP_ACCESS_TOKEN_EXPIRE_MINUTES=30
# APP_REFRESH_TOKEN_EXPIRE_DAYS=7
