# Python
backend/venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.env

# Node
frontend/node_modules/
frontend/dist/

# The built frontend, copied into the image by backend/Dockerfile. Only
# present locally if you've run a build by hand; never committed.
backend/static/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary/debug files
error_output.txt

# Ingest snapshots (local DB backups generated by stats ingester)
backend/rankings_ingester/backups/

# Misc
# Local notes / prompt scratch - not useful to a reader of the repo.
claude.md
# Personal study tracker for walking through this codebase. Same deal.
LEARNING.md

# Screenshots
# Working screenshots pasted in for review are noise in the history. The four
# images the README renders are named in docs/screenshots/README.md and are
# un-ignored below, so they still commit normally once captured.
/screenshots/
docs/screenshots/*.png
!docs/screenshots/draft-room.png
!docs/screenshots/rankings.png
!docs/screenshots/analytics.png
!docs/screenshots/assistant.png
